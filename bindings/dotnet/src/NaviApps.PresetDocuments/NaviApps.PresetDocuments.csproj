<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>NaviApps.PresetDocuments</PackageId>
    <Version>0.1.0</Version>
    <Description>Rust-backed versioned preset documents, validation and portable JSON codecs.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable Condition="'$(SdkNativeRuntimeAssets)' == ''">false</IsPackable>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(PresetDocumentsNativeLibrary)" Condition="'$(PresetDocumentsNativeLibrary)' != ''"
          CopyToOutputDirectory="Always">
      <Link Condition="'$(OS)' == 'Windows_NT'">preset_documents.dll</Link>
      <Link Condition="'$(OS)' != 'Windows_NT'">libpreset_documents.dylib</Link>
    </None>
    <None Include="../../README.md" Pack="true" PackagePath="/README.md" />
    <None Include="../../../../ThirdParty/**/*" Exclude="../../../../ThirdParty/**/.DS_Store;../../../../ThirdParty/**/registry-notices.json" Pack="true" PackagePath="licenses/" />
    <None Include="$(SdkNativeRuntimeAssets)/**/*" Condition="'$(SdkNativeRuntimeAssets)' != ''"
          Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PathMap>$(MSBuildProjectDirectory)=/preset-documents/dotnet/$(MSBuildProjectName)</PathMap>
  </PropertyGroup>
</Project>
